import { Link } from "react-router-dom";
import { FiUsers} from "react-icons/fi";

{/*
   Angle droit en (0,0) — coin haut-gauche
   Cathète haute  : y=0  de x=0 → x=W
   Cathète gauche : x=0  de y=0 → y=H
   Hypoténuse     : de (W, 0) → (0, H)
   Condition : cx/W + cy/H <= 1
*/}
function TriangleGrid({ width = 600, height = 500 }) {
  const step = 36;
  const cols = Math.ceil(width / step) + 1;
  const rows = Math.ceil(height / step) + 1;
  const dots  = [];
  const hLines = [];
  const vLines = [];

  const inside = (cx, cy) => cx / width + cy / height <= 1;

  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const cx = c * step;
      const cy = r * step;
      if (!inside(cx, cy)) continue;

      const xRatio = cx / width;
      const opacity = xRatio > 0.80
        ? Math.max(0, 0.85 - (xRatio - 0.80) * 9)
        : 0.85;

      const isAccent = c < 3 && r < 3;
      const radius = isAccent ? 4.5 : c < 6 && r < 6 ? 2.8 : 2;

      dots.push(
        <circle key={`d-${r}-${c}`}
          cx={cx} cy={cy} r={radius}
          fill={isAccent ? "#1e3a8a" : "#64748b"}
          opacity={opacity}
        />
      );
    }
  }

  // Lignes horizontales tronquées net à l'hypoténuse : maxX = W*(1 - cy/H)
  for (let r = 0; r < rows; r++) {
    const cy = r * step;
    if (cy > height) continue;
    const maxX = width * (1 - cy / height);
    if (maxX <= 0) continue;
    hLines.push(
      <line key={`h-${r}`}
        x1={0} y1={cy} x2={maxX} y2={cy}
        stroke="#94a3b8" strokeWidth="0.75" opacity="0.5"
      />
    );
  }

  // Lignes verticales tronquées net à l'hypoténuse : maxY = H*(1 - cx/W)
  for (let c = 0; c < cols; c++) {
    const cx = c * step;
    if (cx > width) continue;
    const maxY = height * (1 - cx / width);
    if (maxY <= 0) continue;
    vLines.push(
      <line key={`v-${c}`}
        x1={cx} y1={0} x2={cx} y2={maxY}
        stroke="#94a3b8" strokeWidth="0.75" opacity="0.5"
      />
    );
  }

  return (
    <svg
      viewBox={`0 0 ${width} ${height}`}
      style={{ width, height, position: "absolute", top: 0, left: 0 }}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      {/* Remplissage très léger */}
      <polygon points={`0,0 ${width},0 0,${height}`} fill="rgba(30,58,138,0.018)" />

      {hLines}
      {vLines}
      {dots}



      {/* Équerre angle droit coin (0,0) */}
      <polyline points="0,22 22,22 22,0"
        fill="none" stroke="#1e3a8a" strokeWidth="1.4" opacity="0.25"
      />
      <rect x={3} y={3} width={30} height={30} rx="7"
        fill="none" stroke="#1e3a8a" strokeWidth="1.6" opacity="0.22"
      />
    </svg>
  );
}

